# Copia este archivo como ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" real a un repositorio público.

# Clave secreta para firmar las sesiones (JWT). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clave secreta APARTE para gestionar usuarios sin usar el Shell (crear, ver,
# cambiar contraseña, eliminar). Genera una distinta a la de arriba, con el
# mismo comando. Guárdala solo tú -- quien la tenga puede crear/eliminar
# usuarios de la herramienta.
ADMIN_KEY=

# Puerto donde correrá el servidor (opcional, por defecto 3000)
PORT=3000

# "production" activa la cookie segura (solo funciona detrás de HTTPS)
NODE_ENV=development
